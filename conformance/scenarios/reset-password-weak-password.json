{
    "id": "reset-password-weak-password",
    "description": "A password that is too weak is a 422 with the messages per field.",
    "now": "2026-01-01T10:00:00Z",
    "start": {
        "session": "none"
    },
    "steps": [
        {
            "do": "auth.resetPassword",
            "args": {
                "token": "exchange-reset-token-1",
                "password": "short"
            },
            "calls": [
                "reset-weak-password"
            ],
            "expect": {
                "error": {
                    "kind": "http",
                    "status": 422,
                    "code": "validation_failed",
                    "fieldErrors": {
                        "password": [
                            "The password field must be at least 8 characters."
                        ]
                    }
                }
            }
        }
    ],
    "serves": {
        "reset-weak-password": 1
    }
}
