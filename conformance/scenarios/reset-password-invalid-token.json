{
    "id": "reset-password-invalid-token",
    "description": "A key that is wrong, used or expired is a 401 with the code invalid_token.",
    "now": "2026-01-01T10:00:00Z",
    "start": {
        "session": "none"
    },
    "steps": [
        {
            "do": "auth.resetPassword",
            "args": {
                "token": "exchange-reset-token-0",
                "password": "exchange-new-password-1"
            },
            "calls": [
                "reset-invalid-token"
            ],
            "expect": {
                "error": {
                    "kind": "http",
                    "status": 401,
                    "code": "invalid_token"
                }
            }
        }
    ],
    "serves": {
        "reset-invalid-token": 1
    }
}
