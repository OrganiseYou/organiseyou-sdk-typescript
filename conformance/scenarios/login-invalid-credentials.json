{
    "id": "login-invalid-credentials",
    "description": "A wrong password is an error with the code invalid_credentials, and the session stays signed out.",
    "now": "2026-01-01T10:00:00Z",
    "start": {
        "session": "none"
    },
    "steps": [
        {
            "do": "auth.signIn",
            "args": {
                "identifier": "ada@example.test",
                "password": "exchange-wrong-password"
            },
            "calls": [
                "login-invalid-credentials"
            ],
            "expect": {
                "error": {
                    "kind": "http",
                    "status": 401,
                    "code": "invalid_credentials"
                },
                "state": {
                    "status": "signedOut",
                    "reason": "none"
                }
            }
        }
    ],
    "serves": {
        "login-invalid-credentials": 1
    }
}
