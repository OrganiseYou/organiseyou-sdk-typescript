{
    "id": "reset-invalid-token",
    "description": "A key that is wrong, used or expired.",
    "synthetic": false,
    "request": {
        "method": "POST",
        "path": "/auth/password/reset",
        "query": {},
        "headers": {
            "Content-Type": "application/json"
        },
        "body": {
            "token": "exchange-reset-token-0",
            "password": "exchange-new-password-1"
        }
    },
    "response": {
        "status": 401,
        "headers": {
            "Content-Type": "application/json",
            "Cache-Control": "no-store, private",
            "WWW-Authenticate": "Bearer resource_metadata=\"https://api.example.test/.well-known/oauth-protected-resource\""
        },
        "body": {
            "error": "invalid_token",
            "message": "This password reset link is not valid or has expired. Ask for a new one."
        }
    }
}
