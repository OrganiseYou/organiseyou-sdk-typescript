{
    "id": "reset-weak-password",
    "description": "A new password that is too weak: 422, and the key stays usable.",
    "synthetic": false,
    "request": {
        "method": "POST",
        "path": "/auth/password/reset",
        "query": {},
        "headers": {
            "Content-Type": "application/json"
        },
        "body": {
            "token": "exchange-reset-token-1",
            "password": "short"
        }
    },
    "response": {
        "status": 422,
        "headers": {
            "Content-Type": "application/json",
            "Cache-Control": "no-store, private"
        },
        "body": {
            "error": "validation_failed",
            "message": "The password field must be at least 8 characters.",
            "errors": {
                "password": [
                    "The password field must be at least 8 characters."
                ]
            }
        }
    }
}
