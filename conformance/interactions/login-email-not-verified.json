{
    "id": "login-email-not-verified",
    "description": "A correct password before the link of the registration mail was followed.",
    "synthetic": false,
    "request": {
        "method": "POST",
        "path": "/auth/token",
        "query": {},
        "headers": {
            "Content-Type": "application/json"
        },
        "body": {
            "identifier": "cleo@example.test",
            "password": "exchange-password-1"
        }
    },
    "response": {
        "status": 401,
        "headers": {
            "Content-Type": "application/json",
            "Cache-Control": "no-store, private",
            "WWW-Authenticate": "Bearer resource_metadata=\"https://api.example.test/.well-known/oauth-protected-resource\""
        },
        "body": {
            "error": "email_not_verified",
            "message": "The e-mail address has not been verified yet."
        }
    }
}
