{
    "id": "me-rate-limited",
    "description": "A credential limit reached: 429 with Retry-After and the RateLimit headers.",
    "synthetic": false,
    "request": {
        "method": "GET",
        "path": "/rest/me",
        "query": {},
        "headers": {
            "Authorization": "Bearer oyo_exchange_a10"
        }
    },
    "response": {
        "status": 429,
        "headers": {
            "Content-Type": "application/json",
