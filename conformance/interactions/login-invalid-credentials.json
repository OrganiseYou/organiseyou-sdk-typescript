{
    "id": "login-invalid-credentials",
    "description": "A wrong password. The same answer for an unknown address and a person who is not a member here.",
    "synthetic": false,
    "request": {
        "method": "POST",
        "path": "/auth/token",
        "query": {},
        "headers": {
            "Content-Type": "application/json"
        },
        "body": {
            "identifier": "ada@example.test",
            "password": "exchange-wrong-password"
        }
    },
    "response": {
        "status": 401,
        "headers": {
            "Content-Type": "application/json",
            "Cache-Control": "no-store, private",
            "WWW-Authenticate": "Bearer resource_metadata=\"https://api.example.test/.well-known/oauth-protected-resource\""
        },
        "body": {
            "error": "invalid_credentials",
            "message": "Invalid e-mail address or password."
        }
    }
}
